# ─── AI ───────────────────────────────────────────────
# Groq API Key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ─── AUTH ─────────────────────────────────────────────
# Random secret key for JWT signing + encryption (make it long & random)
SECRET_KEY=your_super_secret_key_here

# ─── DISCORD ──────────────────────────────────────────
# Each user provides their own Discord bot token at runtime (stored in DB)
# This is just the default/admin bot token if needed
DISCORD_BOT_TOKEN=your_discord_token_here

# ─── GOOGLE CALENDAR ──────────────────────────────────
# Path to Google OAuth credentials file (from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── SERVICES ─────────────────────────────────────────
# WhatsApp Node.js microservice URL
WHATSAPP_SERVICE_URL=http://localhost:3001

# Backend URL
BACKEND_URL=http://localhost:8000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# ─── DATABASE ─────────────────────────────────────────
DATABASE_URL=sqlite:///./autome.db
